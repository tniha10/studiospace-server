# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string.
# Add the database name at the end, for example:
# mongodb+srv://user:password@cluster.mongodb.net/studiospace
MONGODB_URI=
MONGODB_DB=studiospace

# Public origin of the Next.js app (the /api path is proxied to this server).
BETTER_AUTH_URL=http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000

# Generate both secrets with: openssl rand -base64 32
BETTER_AUTH_SECRET=
JWT_SECRET=

# Google OAuth (optional locally, required for Google sign-in).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ImgBB image uploads (optional, the studio form also accepts an image URL).
IMGBB_API_KEY=
